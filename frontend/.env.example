# Backend API (Go service) — required in every environment.
NEXT_PUBLIC_API_BASE=http://localhost:8068
NEXT_PUBLIC_WS_BASE=ws://localhost:8068

# NextAuth — required for deployment. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers — optional. Omit a pair to disable that provider; email/password sign-in
# still works without them.
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
